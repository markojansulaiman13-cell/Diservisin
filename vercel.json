{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/login", "destination": "/index.html" },
    { "source": "/home", "destination": "/index.html" },
    { "source": "/garage", "destination": "/index.html" },
    { "source": "/catalog", "destination": "/index.html" },
    { "source": "/history", "destination": "/index.html" },
    { "source": "/loyalty", "destination": "/index.html" },
    { "source": "/pos", "destination": "/index.html" },
    { "source": "/workshop/settings", "destination": "/index.html" }
  ]
}
